#!/usr/bin/env bash
# claude-profile — run Claude Code under separate accounts on one machine.
#
# A profile <name> is a config dir at $HOME/.claude-<name>, selected through
# CLAUDE_CONFIG_DIR. Claude Code keys its macOS Keychain entry and .claude.json
# to that dir, so each profile is a separate login. Read-only harness files are
# symlinked from ~/.claude; everything Claude writes stays inside the profile.
set -euo pipefail

MAIN="$HOME/.claude"
# Read-only user-level content Claude Code loads from the config dir. Files imported by
# CLAUDE.md with a relative "@path" are added at runtime (see shared_entries).
SHARED=(CLAUDE.md rules output-styles skills commands agents hooks)
JSON_WHITELIST='{mcpServers, hasCompletedOnboarding, hasCompletedClaudeInChromeOnboarding, claudeInChromeDefaultEnabled} | with_entries(select(.value != null))'

usage() {
  cat <<EOF
claude-profile — run Claude Code under several accounts on one machine.

Each profile is its own config dir (\$HOME/.claude-<name>) selected via CLAUDE_CONFIG_DIR,
so it has its own login, .claude.json, sessions and plugins. Shared, read-only content
(CLAUDE.md and its @imports, rules/, output-styles/, skills/, commands/, agents/, hooks/)
is symlinked from ~/.claude; settings.json is copied and kept in sync. Requires: claude, jq.

Usage: claude-profile <command> [args]
  new <name> [--shared|--clean] [--no-login]
                            create \$HOME/.claude-<name> and log in
                              --shared  link CLAUDE.md/rules/skills/... from ~/.claude, copy
                                        settings.json, seed MCP servers and memory (default)
                              --clean   empty profile; Claude Code starts from scratch
                            (asked interactively when neither flag is given)
  login <name>              run 'claude auth login' for the profile
  run <name> [claude args]  launch claude under the profile (checks links, syncs settings)
  sync [--force] <name>     copy ~/.claude/settings.json into the profile if it is unmodified
  relink <name>             re-create the shared symlinks
  launcher <name>           (re)create the claude-<name> launcher next to this script
  status                    list profiles with mode, account email and stored credentials

Typical flow:
  claude-profile new work      # creates the dir, installs 'claude-work', opens the browser login
  claude-work                  # second account; plain 'claude' stays the first
EOF
}

die() { echo "claude-profile: $*" >&2; exit 1; }
command -v jq >/dev/null 2>&1 || die "jq is required (brew install jq)"
command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"

profile_dir() {
  local name="${1:-}"
  [[ "$name" =~ ^[A-Za-z0-9_-]+$ ]] || die "profile name must match [A-Za-z0-9_-]+"
  printf '%s' "$HOME/.claude-$name"
}

# SHARED plus any relative @imports found in ~/.claude/CLAUDE.md (e.g. "@RULES.md").
shared_entries() {
  local e imports=()
  for e in "${SHARED[@]}"; do printf '%s\n' "$e"; done
  [ -f "$MAIN/CLAUDE.md" ] || return 0
  while IFS= read -r e; do
    e="${e#@}"
    case "$e" in /*|~*|"") continue ;; esac   # only paths relative to the config dir
    imports+=("$e")
  done < <(grep -oE '(^|[[:space:]])@[^[:space:]]+' "$MAIN/CLAUDE.md" | tr -d ' \t')
  [ "${#imports[@]}" -gt 0 ] && printf '%s\n' "${imports[@]}" | sort -u
  return 0
}

sha256_8() {  # first 8 hex of sha256 of the argument; shasum (macOS) or sha256sum (Linux)
  if command -v shasum >/dev/null 2>&1; then printf '%s' "$1" | shasum -a 256 | cut -c1-8
  else printf '%s' "$1" | sha256sum | cut -c1-8; fi
}

# Mirrors Claude Code: "Claude Code-credentials-" + first 8 hex of sha256(config dir string).
keychain_service() { printf 'Claude Code-credentials-%s' "$(sha256_8 "$1")"; }

# Is a login stored for this config dir? macOS: Keychain entry; elsewhere: .credentials.json.
has_credentials() {  # $1 = config dir, $2 = keychain service name
  if [ "$(uname -s)" = "Darwin" ]; then security find-generic-password -s "$2" >/dev/null 2>&1
  else [ -f "$1/.credentials.json" ]; fi
}

link_shared() {  # $1 = profile dir; creates missing links, moves anything in the way aside
  local dir="$1" entry src dst bak
  while IFS= read -r entry; do
    src="$MAIN/$entry"; dst="$dir/$entry"
    [ -e "$src" ] || continue
    mkdir -p "$(dirname "$dst")"
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then continue; fi
    if [ -e "$dst" ] || [ -L "$dst" ]; then
      bak="$dst.bak-$(date +%Y%m%d-%H%M%S)"
      mv "$dst" "$bak"; echo "relink: moved $dst -> $bak"
    fi
    ln -s "$src" "$dst"; echo "linked $entry"
  done < <(shared_entries)
}

check_links() {  # $1 = profile dir; non-zero if any expected link is missing or wrong
  local dir="$1" entry ok=0
  while IFS= read -r entry; do
    [ -e "$MAIN/$entry" ] || continue
    if ! { [ -L "$dir/$entry" ] && [ "$(readlink "$dir/$entry")" = "$MAIN/$entry" ]; }; then ok=1; fi
  done < <(shared_entries)
  return $ok
}

# Copy ~/.claude/settings.json into the profile unless the profile's copy was edited
# since the last sync (detected via the .settings.synced snapshot).
sync_settings() {  # $1 = profile dir, $2 = force 0/1, $3 = quiet 0/1
  local dir="$1" force="$2" quiet="$3"
  local src="$MAIN/settings.json" dst="$dir/settings.json" snap="$dir/.settings.synced"
  if [ ! -f "$src" ]; then
    [ "$quiet" = 1 ] || echo "sync: no $src to copy; skipped"
    return 0
  fi
  if [ "$force" = 1 ] || [ ! -f "$dst" ] || cmp -s "$dst" "$snap"; then
    if cmp -s "$src" "$dst"; then
      cp "$src" "$snap"
      [ "$quiet" = 1 ] || echo "sync: already up to date"
    else
      cp "$src" "$dst"; cp "$src" "$snap"
      [ "$quiet" = 1 ] || echo "sync: settings.json updated from ~/.claude"
    fi
    return 0
  fi
  echo "sync: $dst was edited since last sync; left untouched (force with: claude-profile sync --force)" >&2
  return 2
}

MARKER=".claude-profile"   # inside a profile dir: "mode=shared" or "mode=clean"

profile_mode() {  # $1 = profile dir → shared | clean | "" (not a profile)
  if [ -f "$1/$MARKER" ]; then sed -n 's/^mode=//p' "$1/$MARKER"
  elif [ -f "$1/.settings.synced" ]; then echo shared   # created before the marker existed
  fi
}

is_profile() { [ -n "$(profile_mode "$1")" ]; }

ask_mode() {  # prints shared|clean; interactive only when stdin is a terminal
  local choice=""
  if [ -t 0 ]; then
    {
      echo "How should profile \"$1\" be set up?"
      echo "  1) shared — link CLAUDE.md/rules/skills/... from ~/.claude, copy settings.json,"
      echo "              seed MCP servers and auto-memory (default)"
      echo "  2) clean  — empty profile; Claude Code starts from scratch"
      printf 'Choose [1/2]: '
    } >&2
    read -r choice
  fi
  case "$choice" in 2|clean|c) echo clean ;; *) echo shared ;; esac
}

# Write an executable claude-<name> next to this script (works in any shell, no rc edits).
install_launcher() {  # $1 = profile name
  local name="$1" self_dir launcher
  self_dir="$(cd "$(dirname "$0")" && pwd)"
  launcher="$self_dir/claude-$name"
  cat > "$launcher" <<LAUNCHER
#!/usr/bin/env bash
# Generated by claude-profile: run Claude Code under the "$name" profile.
exec "$self_dir/claude-profile" run "$name" "\$@"
LAUNCHER
  chmod +x "$launcher"
  echo "launcher:         $launcher"
}

seed_claude_json() {  # $1 = profile dir
  local dst="$1/.claude.json"
  [ -f "$dst" ] && return 0
  if [ -f "$HOME/.claude.json" ]; then
    jq "$JSON_WHITELIST" "$HOME/.claude.json" > "$dst"
  else
    echo '{}' > "$dst"
  fi
  echo "seeded .claude.json (mcpServers + onboarding flags only)"
}

seed_memory() {  # $1 = profile dir; copies auto-memory per project as a starting point
  local dir="$1" mem proj n=0
  for mem in "$MAIN"/projects/*/memory; do
    [ -d "$mem" ] || continue
    proj="$(basename "$(dirname "$mem")")"
    [ -e "$dir/projects/$proj/memory" ] && continue
    mkdir -p "$dir/projects/$proj"
    cp -R "$mem" "$dir/projects/$proj/memory"
    n=$((n + 1))
  done
  echo "seeded auto-memory for $n project(s)"
}

cmd_new() {
  local name="" nologin=0 mode="" a dir
  for a in "$@"; do
    case "$a" in
      --no-login) nologin=1 ;;
      --shared)   mode=shared ;;
      --clean)    mode=clean ;;
      -*)         die "unknown option: $a" ;;
      *)          name="$a" ;;
    esac
  done
  [ -n "$name" ] || die "usage: claude-profile new <name> [--shared|--clean] [--no-login]"
  dir="$(profile_dir "$name")"
  [ -e "$dir" ] && die "$dir already exists (use relink / sync / login instead)"
  [ -n "$mode" ] || mode="$(ask_mode "$name")"
  mkdir -p "$dir"
  echo "mode=$mode" > "$dir/$MARKER"
  if [ "$mode" = shared ]; then
    link_shared "$dir"
    sync_settings "$dir" 1 0
    seed_claude_json "$dir"
    seed_memory "$dir"
  else
    echo "clean profile: nothing copied from ~/.claude; Claude Code will run its onboarding"
  fi
  echo "mode:             $mode"
  echo "profile dir:      $dir"
  echo "keychain service: $(keychain_service "$dir")"
  install_launcher "$name"
  if [ "$nologin" = 1 ]; then
    echo "next: claude-profile login $name"
  else
    cmd_login "$name"
  fi
}

cmd_login() {
  local dir; dir="$(profile_dir "${1:-}")"
  [ -d "$dir" ] || die "no profile at $dir (run: claude-profile new ${1:-<name>})"
  CLAUDE_CONFIG_DIR="$dir" exec claude auth login
}

cmd_run() {
  local name="${1:-}" dir
  [ -n "$name" ] || die "usage: claude-profile run <name> [claude args]"
  shift
  dir="$(profile_dir "$name")"
  [ -d "$dir" ] || die "no profile at $dir (run: claude-profile new $name)"
  if [ "$(profile_mode "$dir")" = shared ]; then
    check_links "$dir" || echo "claude-profile: shared links out of date in $dir; run: claude-profile relink $name" >&2
    sync_settings "$dir" 0 1 || true
  fi
  export CLAUDE_CONFIG_DIR="$dir"
  exec claude "$@"
}

cmd_sync() {
  local force=0 name="" a dir
  for a in "$@"; do case "$a" in --force|-f) force=1 ;; *) name="$a" ;; esac; done
  dir="$(profile_dir "$name")"
  [ -d "$dir" ] || die "no profile at $dir"
  [ "$(profile_mode "$dir")" = shared ] || die "$dir is a clean profile; nothing is synced from ~/.claude"
  sync_settings "$dir" "$force" 0
}

cmd_relink() {
  local dir; dir="$(profile_dir "${1:-}")"
  [ -d "$dir" ] || die "no profile at $dir"
  [ "$(profile_mode "$dir")" = shared ] || die "$dir is a clean profile; nothing is linked from ~/.claude"
  link_shared "$dir"
  check_links "$dir" && echo "links ok"
}

cmd_launcher() {
  local dir; dir="$(profile_dir "${1:-}")"
  [ -d "$dir" ] || die "no profile at $dir"
  install_launcher "$1"
}

cmd_status() {
  local dir json email svc kc mode
  printf '%-28s %-8s %-32s %s\n' "CONFIG DIR" "MODE" "ACCOUNT" "CREDENTIALS"
  for dir in "$MAIN" "$HOME"/.claude-*; do
    if [ "$dir" = "$MAIN" ]; then
      [ -d "$dir" ] || continue
      json="$HOME/.claude.json"; svc="Claude Code-credentials"; mode="main"
    else
      is_profile "$dir" || continue   # skip unrelated ~/.claude-* dirs
      json="$dir/.claude.json"; svc="$(keychain_service "$dir")"; mode="$(profile_mode "$dir")"
    fi
    email="$(jq -r '.oauthAccount.emailAddress // "not logged in"' "$json" 2>/dev/null || echo "not logged in")"
    if has_credentials "$dir" "$svc"; then kc="present"; else kc="missing"; fi
    printf '%-28s %-8s %-32s %s\n' "${dir/#$HOME/~}" "$mode" "$email" "$kc"
  done
}

case "${1:-}" in
  new)    shift; cmd_new "$@" ;;
  login)  shift; cmd_login "$@" ;;
  run)    shift; cmd_run "$@" ;;
  sync)   shift; cmd_sync "$@" ;;
  relink) shift; cmd_relink "$@" ;;
  launcher) shift; cmd_launcher "$@" ;;
  status) cmd_status ;;
  -h|--help|help|"") usage ;;
  *) die "unknown command: $1" ;;
esac
